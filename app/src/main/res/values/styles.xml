<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <!-- Seen in buttons on alert dialog: -->
        <item name="android:colorAccent">@color/god_accent</item>
    </style>


    <!-- ===== god-termux look ===== -->
    <style name="GodPreferenceTheme" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.God</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.God.Switch</item>
        <item name="preferenceCategoryStyle">@style/Preference.God.Category</item>
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.God</item>
    </style>
    <style name="PreferenceFragment.God" parent="PreferenceFragment.Material">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="allowDividerAfterLastItem">false</item>
    </style>
    <style name="Preference.God">
        <item name="android:layout">@layout/preference_god</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.God.Switch">
        <item name="android:layout">@layout/preference_god</item>
        <item name="widgetLayout">@layout/preference_widget_switch_compat</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.God.Category">
        <item name="android:layout">@layout/preference_category_god</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Widget.God.Button.Tonal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/god_surface2</item>
        <item name="android:textColor">@color/god_accent</item>
        <item name="rippleColor">@color/god_accent_soft</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.God.Button.Filled" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/god_accent</item>
        <item name="android:textColor">@color/god_on_accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- drawer text buttons now use the god look in both modes -->
    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.God.Button.Tonal"/>
    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.God.Button.Tonal"/>

</resources>
