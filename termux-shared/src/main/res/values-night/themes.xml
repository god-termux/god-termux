<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!--
     BaseActivity DayNight DarkActionBar theme.
     https://github.com/material-components/material-components-android/blob/1.4.0/lib/java/com/google/android/material/theme/res/values/themes.xml#L27
    -->
    <style name="Theme.BaseActivity.DayNight.DarkActionBar" parent="Theme.MaterialComponents">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/god_accent</item>
        <item name="colorPrimaryVariant">@color/god_bg</item>
        <item name="colorOnPrimary">@color/god_on_accent</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/god_accent</item>
        <item name="colorSecondaryVariant">@color/god_accent</item>
        <item name="colorOnSecondary">@color/god_on_accent</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/god_bg</item>
        <item name="colorPrimaryDark" tools:targetApi="l">@color/god_bg</item>
        <!-- god-termux look -->
        <item name="android:colorBackground">@color/god_bg</item>
        <item name="android:windowBackground">@color/god_bg</item>
        <item name="colorBackgroundFloating">@color/god_surface</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/god_bg</item>
        <item name="android:textColorPrimary">@color/god_text</item>
        <item name="android:textColorSecondary">@color/god_text2</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.God.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.God.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.God.Large</item>


        <!-- Text color. -->
        <item name="android:textColorLink">@color/blue_link_dark</item>
    </style>

    <!-- BaseActivity DayNight NoActionBar theme. -->
    <style name="Theme.BaseActivity.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>





    <!--
      BaseDialog DayNight theme.
      https://github.com/material-components/material-components-android/blob/1.4.0/lib/java/com/google/android/material/dialog/res/values/themes.xml#L70
     -->
    <style name="ThemeOverlay.BaseDialog.DayNight" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.God.Medium</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/god_accent</item>
        <item name="colorPrimaryVariant">@color/god_bg</item>
        <item name="colorOnPrimary">@color/god_on_accent</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/god_accent</item>
        <item name="colorSecondaryVariant">@color/god_accent</item>
        <item name="colorOnSecondary">@color/god_on_accent</item>

        <!-- Surface color. -->
        <item name="colorSurface">@color/god_surface</item>
        <item name="colorOnSurface">@color/god_text</item>

        <!-- Dialog title panel style. -->
        <item name="materialAlertDialogTitlePanelStyle">@style/BaseDialog.Title.Panel</item>

        <!-- Dialog message text style. -->
        <item name="materialAlertDialogBodyTextStyle">@style/BaseDialog.Message.Text.Dark</item>
    </style>

</resources>
