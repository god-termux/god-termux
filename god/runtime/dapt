#!/data/data/com.termux/files/usr/bin/bash
# dapt: apt for an isolated Debian (arm64) tree in $PREFIX/debian (does not touch Termux's own dpkg/apt).
#   dapt init | update | install PKG | remove PKG | search X | show X | list --installed | dpkg ARGS | dpkg-query ARGS | fixlinks
P=${PREFIX:-/data/data/com.termux/files/usr}
D=${DAPT_ROOT:-$P/debian}
usage() {
  echo "Usage: dapt [--root DIR|--root=DIR] COMMAND [ARGS...]" >&2
  echo "       dapt install PKG --fix     (repair dependencies in the selected Debian root)" >&2
  echo "       dapt init|update|remove PKG|search TERM|show PKG|list --installed|fix" >&2
  echo "Debian root: $D" >&2
  echo "--root selects a separate Debian tree; initialize it with 'dapt --root DIR init' first." >&2
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    --root)
      [ "$#" -ge 2 ] && [ -n "$2" ] || { usage; exit 2; }
      D=$2; shift 2 ;;
    --root=*)
      D=${1#--root=}; [ -n "$D" ] || { usage; exit 2; }; shift ;;
    --help|-h) usage; exit 0 ;;
    *) break ;;
  esac
done
[ -n "$D" ] || { usage; exit 2; }
FIX_AFTER=0
args=()
for arg in "$@"; do
  if [ "$arg" = "--fix" ]; then FIX_AFTER=1; else args+=("$arg"); fi
done
set -- "${args[@]}"
if [ "$FIX_AFTER" = 1 ] && [ "${1:-}" != install ]; then
  echo "dapt: --fix is supported with 'install': dapt install PKG --fix" >&2
  exit 2
fi
gen() { sed "s#@P@#$P#g; s#@D@#$D#g"; }

# Bump when wrapper templates change; include both roots so relocated trees refresh.
WRAPPER_VERSION=5
WRAPPER_TOOLS=(dpkg fixlinks update-alternatives dpkg-maintscript-helper mkdir chown chgrp
  update-rc.d invoke-rc.d deb-systemd-helper deb-systemd-invoke systemctl systemd-tmpfiles
  systemd-sysusers systemd-machine-id-setup policy-rc.d add-shell remove-shell dpkg-statoverride
  pam-auth-update adduser addgroup useradd groupadd usermod)
wrappers_current() {
  local version t
  [ -r "$D/.ddpkg-bin/.version" ] || return 1
  IFS= read -r version < "$D/.ddpkg-bin/.version"
  [ "$version" = "$WRAPPER_VERSION|$P|$D" ] || return 1
  for t in "${WRAPPER_TOOLS[@]}"; do [ -x "$D/.ddpkg-bin/$t" ] || return 1; done
}

wrappers() {
  wrappers_current && return 0
  mkdir -p "$D/.ddpkg-bin"
  gen > "$D/.ddpkg-bin/dpkg" <<'E2'
#!@P@/bin/bash
# dpkg for the isolated Debian tree. Under the fhs-run supervisor in "Debian mode" so maintainer scripts see /etc,/usr,/var inside @D@.
D=@D@
export FHS_DEBIAN=1 DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true
R=""; [ -x @P@/glibc/shim/fhs-run ] && R=@P@/glibc/shim/fhs-run
PATH="$D/.ddpkg-bin:$D/usr/bin:$D/bin:$PATH:$D/usr/sbin:$D/sbin" LD_PRELOAD="@P@/glibc/shim/libdapt-nolink.so${LD_PRELOAD:+:$LD_PRELOAD}" $R @P@/bin/dpkg --admindir=$D/var/lib/dpkg --instdir=$D --force-architecture --force-script-chrootless --force-depends --log=$D/var/log/dpkg.log "$@"
rc=$?
# Queries do not change links. Unknown actions retain the full repair pass.
case "$1" in
  -s|--status|-l|--list|-L|--listfiles|-S|--search|-C|--audit|--get-selections|--print-architecture|--print-foreign-architectures|--version|--help) ;;
  *) "$D/.ddpkg-bin/fixlinks" ;;
esac
exit $rc
E2
  gen > "$D/.ddpkg-bin/fixlinks" <<'E2'
#!@P@/bin/bash
# absolute symlinks inside the Debian tree point at host paths; the kernel resolves them itself, so re-point them into the tree
D=@D@
find "$D" -xdev -type l -lname '/*' ! -lname "$D/*" ! -lname '/data/*' ! -lname '/proc/*' ! -lname '/sys/*' ! -lname '/dev/*' ! -lname '/system/*' -printf '%p\0%l\0' 2>/dev/null | while IFS= read -r -d '' l && IFS= read -r -d '' t; do
  case "$t" in
    "$D"/*|/data/*|/proc/*|/sys/*|/dev/*|/system/*) continue ;;
    /*) if [ -e "$D$t" ] || [ -L "$D$t" ]; then ln -sfn "$D$t" "$l"; fi ;;
  esac
done
E2
  gen > "$D/.ddpkg-bin/update-alternatives" <<'E2'
#!@P@/bin/bash
exec @P@/bin/update-alternatives --instdir "@D@" --altdir "@D@/etc/alternatives" --admindir "@D@/var/lib/dpkg/alternatives" "$@"
E2
  # maintainer scripts call chown/chgrp for root:* owners, which an unprivileged app uid cannot do; ignore it
  printf '#!@P@/bin/sh\nexit 0\n' | gen > "$D/.ddpkg-bin/dpkg-maintscript-helper"   # Termux dpkg does not ship it
  # mkdir -p chdir()s into each parent, and chdir is not translated by the path supervisor: pass Debian-rooted paths explicitly
  gen > "$D/.ddpkg-bin/mkdir" <<'E2'
#!@P@/bin/bash
a=(); for x in "$@"; do case "$x" in /*) case "$x" in @D@/*|@P@/*|/data/*|/sdcard/*|/storage/*|/proc/*|/dev/*) a+=("$x");; *) a+=("@D@$x");; esac;; *) a+=("$x");; esac; done
exec @P@/bin/mkdir "${a[@]}"
E2
  for t in chown chgrp; do gen > "$D/.ddpkg-bin/$t" <<E2
#!@P@/bin/bash
@P@/bin/$t "\$@" 2>/dev/null; exit 0
E2
  done
  # init-system / account helpers that have nothing to do in an app sandbox: no-ops so maintainer scripts finish
  for t in update-rc.d invoke-rc.d deb-systemd-helper deb-systemd-invoke systemctl systemd-tmpfiles systemd-sysusers systemd-machine-id-setup policy-rc.d add-shell remove-shell dpkg-statoverride pam-auth-update adduser addgroup useradd groupadd usermod; do
    printf '#!@P@/bin/sh\nexit 0\n' | gen > "$D/.ddpkg-bin/$t"; done
  chmod +x "$D/.ddpkg-bin/"* || return
  printf '%s\n' "$WRAPPER_VERSION|$P|$D" > "$D/.ddpkg-bin/.version"
}

# regenerate the caches Debian maintainer scripts would have built with host tools (they pick up Termux's bionic tools first, which is wrong for this tree).
# A cache is rebuilt only when the files it is built from changed, or something else rewrote the cache file, since our last run
# (fingerprints in $D/var/cache/dapt-refresh). "dapt refresh" rebuilds everything.
RC_FMT='%p %s %T@ %C@\n'
rc_state() {   # the files a cache is built from plus the cache file(s): name, size, mtime, ctime. Directories are left out: writing a cache touches them.
  case "$1" in
    pixbuf)  find "$D/usr/lib/aarch64-linux-gnu/gdk-pixbuf-2.0" -mindepth 2 ! -type d \( -path '*/loaders/*' -o -name loaders.cache \) -printf "$RC_FMT" ;;
    schemas) find "$D/usr/share/glib-2.0/schemas" -mindepth 1 ! -type d -printf "$RC_FMT" ;;
    mime)    find "$D/usr/share/mime/packages" "$D/usr/share/mime/mime.cache" ! -type d -printf "$RC_FMT" ;;
    icons)   find "$D/usr/share/icons" -mindepth 2 ! -type d -printf "$RC_FMT" ;;
  esac 2>/dev/null
}
rc_inputs() {  # the same listing without the cache files
  local l
  while IFS= read -r l; do
    case "$l" in */loaders.cache\ *|*/gschemas.compiled\ *|*/mime.cache\ *|*/icon-theme.cache\ *) ;; *) printf '%s\n' "$l" ;; esac
  done <<< "$1"
}
refresh_caches() {
  [ -x "$P/glibc/shim/fhs-run" ] || return 0
  local force=$1 dir="$D/var/cache/dapt-refresh" n old now built script='' todo=()
  local -A before
  [ "$(find "$D" -maxdepth 0 -printf ok 2>/dev/null)" = ok ] || force=1   # find without -printf: no fingerprints, rebuild everything as before
  for n in pixbuf schemas mime icons; do
    before[$n]=$(rc_state $n)
    if [ -z "$force" ]; then
      [ -n "${before[$n]}" ] || continue   # neither inputs nor a cache
      old=; [ -r "$dir/$n" ] && old=$(< "$dir/$n")
      [ "$old" != "${before[$n]}" ] || continue
    fi
    todo+=($n)
    case $n in   # each command prints its name when the cache was rebuilt
      pixbuf)  script+='t=/usr/lib/aarch64-linux-gnu/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders; [ -x $t ] && $t --update-cache >/dev/null 2>&1 && echo pixbuf
' ;;
      schemas) script+='[ -x /usr/bin/glib-compile-schemas ] && /usr/bin/glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 && echo schemas
' ;;
      # update-mime-database syncs each of its ~900 output files to disk; a cache that can be rebuilt does not need that
      mime)    script+='[ -x /usr/bin/update-mime-database ] && PKGSYSTEM_ENABLE_FSYNC=0 /usr/bin/update-mime-database /usr/share/mime >/dev/null 2>&1 && echo mime
' ;;
      icons)   script+='if [ -x /usr/bin/gtk-update-icon-cache ]; then ok=1; for d in /usr/share/icons/*/; do [ -f "${d}index.theme" ] || continue; /usr/bin/gtk-update-icon-cache -qf "$d" >/dev/null 2>&1 || ok=; done; [ -n "$ok" ] && echo icons; fi
' ;;
    esac
  done
  script+='[ -x /usr/bin/fc-cache ] && /usr/bin/fc-cache -s >/dev/null 2>&1; true'   # checks its own directories, cheap when nothing changed
  built=$(FHS_DEBIAN=1 "$P/glibc/shim/fhs-run" "$P/bin/sh" -c "$script" 2>/dev/null)
  for n in "${todo[@]}"; do
    case $'\n'"$built"$'\n' in *$'\n'"$n"$'\n'*) ;; *) continue ;; esac   # not rebuilt (tool missing or failed): try again next time
    now=$(rc_state $n)
    # inputs that changed while the tool ran are not in the cache: leave the old fingerprint so the next run rebuilds
    [ "$(rc_inputs "$now")" = "$(rc_inputs "${before[$n]}")" ] || continue
    [ -d "$dir" ] || mkdir -p "$dir" || return 0
    printf '%s\n' "$now" > "$dir/$n"
  done
}

init() {
  echo "dapt: initialising Debian tree in $D"
  mkdir -p "$D"/{var/lib/dpkg/{info,updates,alternatives},var/lib/apt/lists/partial,var/cache/apt/archives/partial,var/log,etc/{dpkg,alternatives,apt/{sources.list.d,preferences.d,apt.conf.d,trusted.gpg.d}},tmp,usr/{bin,lib,share/keyrings},.ddpkg-bin}
  touch "$D/var/lib/dpkg/status" "$D/var/lib/dpkg/available"
  wrappers
  gen > "$D/etc/apt/apt.conf" <<'E2'
Dir "@D@/";
Dir::Etc "etc/apt";
Dir::State "var/lib/apt";
Dir::State::status "@D@/var/lib/dpkg/status";
Dir::Cache "var/cache/apt";
Dir::Log "var/log/apt";
Dir::Bin::dpkg "@D@/.ddpkg-bin/dpkg";
Dir::Bin::methods "@P@/lib/apt/methods";
Dir::Bin::gpgv "@P@/bin/gpgv";
Dir::Etc::sourcelist "/dev/null";
Dir::Etc::sourceparts "@D@/etc/apt/sources.list.d";
Dir::Etc::preferencesparts "@D@/etc/apt/preferences.d";
Dir::Etc::parts "@D@/etc/apt/apt.conf.d";
Dir::Etc::trusted "/dev/null";
Dir::Etc::trustedparts "@D@/etc/apt/trusted.gpg.d";
APT::Architecture "arm64";
APT::Architectures { "arm64"; };
APT::Install-Recommends "false";
Debug::NoLocking "true";
E2
  [ -f "$D/etc/apt/sources.list.d/debian.sources" ] || gen > "$D/etc/apt/sources.list.d/debian.sources" <<'E2'
Types: deb
URIs: http://deb.debian.org/debian
Suites: stable stable-updates
Components: main
Architectures: arm64
Signed-By: @D@/usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: stable-security
Components: main
Architectures: arm64
Signed-By: @D@/usr/share/keyrings/debian-archive-keyring.gpg
E2
  printf 'Package: libc6 libgcc-s1 libstdc++6 zlib1g systemd systemd-sysv libpam-systemd adduser passwd\nPin: release *\nPin-Priority: -1\n' > "$D/etc/apt/preferences.d/termux-stubs"
  # architecture
  "$D/.ddpkg-bin/dpkg" --print-foreign-architectures 2>/dev/null | grep -qx arm64 || "$D/.ddpkg-bin/dpkg" --add-architecture arm64
  # archive keyring
  if [ ! -s "$D/usr/share/keyrings/debian-archive-keyring.gpg" ]; then
    echo "dapt: fetching Debian archive keyring"; T=$(mktemp -d); U=http://deb.debian.org/debian/pool/main/d/debian-archive-keyring/
    F=$(curl -fsSL "$U" | grep -oE 'debian-archive-keyring_[0-9][^"]*_all\.deb' | sort -V | tail -1) || true
    [ -n "$F" ] && curl -fsSL -o "$T/k.deb" "$U$F" && dpkg-deb -x "$T/k.deb" "$T/x" && cp "$T/x/usr/share/keyrings/debian-archive-keyring.gpg" "$D/usr/share/keyrings/" || { echo "dapt: could not fetch keyring" >&2; rm -rf "$T"; return 1; }
    rm -rf "$T"
  fi
  # stub packages for what Termux's glibc already provides / what cannot run here (no init system)
  S=$(mktemp -d); have=0
  for spec in libc6:2.44-0termux libgcc-s1:15.2.0-0termux libstdc++6:15.2.0-0termux zlib1g:1:1.3.2-0termux systemd:257.99-0termux systemd-sysv:257.99-0termux libpam-systemd:257.99-0termux adduser:3.999-0termux passwd:1:4.999-0termux; do n=${spec%%:*}; v=${spec#*:}
    "$D/.ddpkg-bin/dpkg" -s "$n" 2>/dev/null | grep -q "^Description: stub" && continue
    mkdir -p "$S/$n/DEBIAN"; chmod 755 "$S/$n" "$S/$n/DEBIAN"; have=1
    printf 'Package: %s\nVersion: %s\nArchitecture: arm64\nMaintainer: god-termux <nobody@localhost>\nSection: libs\nPriority: required\nDescription: stub: provided by Termux / not applicable here\n Dummy package so Debian arm64 packages see this dependency as satisfied.\n' "$n" "$v" > "$S/$n/DEBIAN/control"
    dpkg-deb --build -Zgzip "$S/$n" "$S/$n.deb" >/dev/null
  done
  if [ $have = 1 ]; then "$D/.ddpkg-bin/dpkg" -i "$S"/*.deb >/dev/null && echo "dapt: stubs installed" || echo "dapt: stub install failed" >&2; fi
  rm -rf "$S"
  echo "dapt: ready. Next: dapt update"
}

export APT_CONFIG=$D/etc/apt/apt.conf
export DEBIAN_FRONTEND=noninteractive DEBCONF_NONINTERACTIVE_SEEN=true TZ=${TZ:-UTC}   # maintainer scripts must never prompt
[ -d "$D/.ddpkg-bin" ] && wrappers
case "${0##*/}" in
  dapt-get)   exec $P/bin/apt-get "$@" ;;
  dapt-cache) exec $P/bin/apt-cache "$@" ;;
esac
case "$1" in
  init)       init; exit $? ;;
  dpkg)       shift; exec "$D/.ddpkg-bin/dpkg" "$@" ;;
  dpkg-query) shift; exec $P/bin/dpkg-query --admindir=$D/var/lib/dpkg "$@" ;;
  fixlinks)   exec "$D/.ddpkg-bin/fixlinks" ;;
  refresh)    refresh_caches force; exit $? ;;
  fix)
    [ -f "$APT_CONFIG" ] || { echo "dapt: tree is not initialised; run 'dapt init' first" >&2; exit 1; }
    echo "dapt: repairing Debian packages in $D"
    "$P/bin/apt-get" --fix-broken install -y || exit $?
    "$D/.ddpkg-bin/dpkg" --configure -a || exit $?
    refresh_caches
    exit $? ;;
esac
[ -f "$APT_CONFIG" ] || { echo "dapt: Debian tree is not initialised; running 'dapt init'" >&2; init || exit 1; }
if [ "$FIX_AFTER" = 1 ]; then
  echo "dapt: --fix: resolving the package and repairing dependencies in $D"
  "$P/bin/apt-get" --fix-broken install -y "${@:2}"
  rc=$?
else
  "$P/bin/apt" "$@"; rc=$?
fi
case "$1" in install|reinstall|upgrade|full-upgrade|dist-upgrade|remove|purge|autoremove) refresh_caches ;; esac
exit "$rc"
