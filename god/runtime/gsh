#!/data/data/com.termux/files/usr/bin/bash
# gsh: compatibility wrapper, the logic now lives in `dsu` (shell uid 2000 via Shizuku/rish or ADB; not root).
#   gsh status | gsh pair CODE | gsh -c 'cmd' | gsh cmd args...   (the last form joins the arguments with spaces, as before)
command -v dsu >/dev/null 2>&1 || { echo "gsh: dsu not found" >&2; exit 127; }
case "$1" in
  status) shift; exec dsu status "$@" ;;
  pair)   shift; exec dsu pair "$@" ;;
  -c)     shift; exec dsu -c "$1" ;;
  "")     exec dsu -h ;;
  *)      [ -n "$_DSU_DEBUG" ] && echo "gsh: arguments are joined with spaces (use dsu for exact quoting)" >&2
          exec dsu -c "$*" ;;
esac
