#!/data/data/com.termux/files/usr/bin/bash
# wlchromium [URL...]  - Debian's Chromium (dapt install --no-install-recommends chromium) as a Wayland client of the god-termux compositor:
# no nested labwc and no XWayland (two CPU copies of the screen less than Chromium inside xfce-wl). No XFCE panel/window management.
# Software rendering (a client of this compositor has only wl_shm buffers). Own profile: ~/.config/god-chromium.
# Extra flags: WLCHROMIUM_FLAGS="--force-device-scale-factor=1.5 ...". Log: $PREFIX/tmp/wlchromium.log (when started in the background)
P=${PREFIX:-/data/data/com.termux/files/usr}; D=$P/debian; F=$P/glibc/shim/fhs-run
[ -x "$D/usr/bin/chromium" ] || { echo "wlchromium: Debian chromium missing. Run: dapt update && dapt install -y --no-install-recommends chromium" >&2; exit 1; }
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=$P/tmp wlrun --open || exit 1
# WLCHROMIUM_DISPLAY=wayland-1 runs it inside the nested labwc (xfce-wl) instead, for comparisons
export XDG_RUNTIME_DIR=$P/tmp WAYLAND_DISPLAY=${WLCHROMIUM_DISPLAY:-wayland-0} FHS_DEBIAN=1 XDG_DATA_DIRS=/usr/share XDG_CONFIG_DIRS=/etc/xdg NO_AT_BRIDGE=1
export XDG_CONFIG_HOME=$HOME/.config/god-chromium XDG_CACHE_HOME=$HOME/.cache/god-chromium
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"
# WLCHROMIUM_GPU=panvk: render on the GPU through ANGLE -> Vulkan -> the open PanVK driver (glibc build of zenithblue-oss/panvk-kbase-android in ~/gpu-drivers,
# needs $PREFIX/glibc/god-lib); anything else: software rendering. WLCHROMIUM_ICD overrides the ICD file.
GPU_FLAGS="--disable-gpu"
if [ "${WLCHROMIUM_GPU:-}" = panvk ]; then
  export VK_ICD_FILENAMES=${WLCHROMIUM_ICD:-$HOME/gpu-drivers/zenith/icd-glibc.json}
  # Chromium refuses its own Skia-Vulkan output on ozone-wayland ("not compatible with Vulkan"): PanVK is used by ANGLE (GL on top of Vulkan) only
  GPU_FLAGS="--use-gl=angle --use-angle=vulkan --enable-features=Vulkan,DefaultANGLEVulkan,VulkanFromANGLE --ignore-gpu-blocklist --enable-gpu-rasterization --enable-accelerated-2d-canvas --canvas-oop-rasterization"
fi
export WLC_FLAGS="--ozone-platform=wayland --no-sandbox --disable-dev-shm-usage $GPU_FLAGS --user-data-dir=$XDG_CONFIG_HOME/profile-${WLCHROMIUM_GPU:-sw} $WLCHROMIUM_FLAGS"
# shellcheck disable=SC2016
# A session bus WITHOUT service activation (no servicedir): otherwise Chromium makes D-Bus start xfce4-notifyd (fails: our compositor has no wlr-layer-shell, shows an error window)
# and gnome-keyring ("Choose password for new keyring" window). --password-store=basic keeps Chromium from asking for a keyring at all.
DBCONF=$P/tmp/wlchromium-dbus.conf
cat > "$DBCONF" <<EOF2
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig><type>session</type><listen>unix:tmpdir=$P/tmp</listen><auth>EXTERNAL</auth>
<policy context="default"><allow send_destination="*" eavesdrop="true"/><allow eavesdrop="true"/><allow own="*"/></policy></busconfig>
EOF2
export WLC_FLAGS="$WLC_FLAGS --password-store=basic"
exec "$F" "$P/bin/sh" -c "exec dbus-run-session --config-file=$DBCONF -- /usr/bin/chromium \$WLC_FLAGS \"\$@\"" sh "$@"
